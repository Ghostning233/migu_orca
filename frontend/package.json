{
  "name": "migu-orca-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "MiGuOrca Stage 27 Vue 3 + TypeScript + Vite 前端工程（由 Flask 同源托管，生产不依赖 Node 运行时）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
